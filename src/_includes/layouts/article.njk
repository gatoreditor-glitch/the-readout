---
layout: layouts/base.njk
---
<article class="article">
  <p class="kicker">{{ section }}{% if sample %} <span class="sample-badge">Sample</span>{% endif %}</p>
  <h1 class="article-title">{{ title }}</h1>
  <p class="byline">By {{ author or "Staff" }} &middot; <time>{{ date | date("MMMM d, yyyy") }}</time></p>
  {% if image %}
  <figure class="article-hero">
    <img src="{{ image | url }}" alt="{{ title }}">
  </figure>
  {% endif %}
  {% if audio %}
  <div class="audio-player">
    <p class="audio-label">Listen to this article</p>
    <audio controls preload="none" src="{{ audio | url }}"></audio>
  </div>
  {% endif %}
  {% if excerpt %}<p class="excerpt">{{ excerpt }}</p>{% endif %}
  <div class="article-body">
    {# Prefix root-absolute asset paths in markdown content (the | url filter doesn't reach inside rendered markdown) #}
    {{ content | replace('src="/assets/', 'src="' ~ pathPrefix ~ 'assets/') | replace('href="/assets/', 'href="' ~ pathPrefix ~ 'assets/') | safe }}
  </div>
  <p class="backlink"><a href="{{ '/' | url }}">&larr; Back to top stories</a></p>
</article>
